Data_U0U1_bias = [Data_U0U1(:, 1), Data_U0U1(:, 2) - c*(delta_t(1) + delta_t(2))];
Data_U0U2_bias = [Data_U0U2(:, 1), Data_U0U2(:, 2) - c*(delta_t(1) + delta_t(3))];
Data_U0U3_bias = [Data_U0U3(:, 1), Data_U0U3(:, 2) - c*(delta_t(1) + delta_t(4))];
Data_U1U2_bias = [Data_U1U2(:, 1), Data_U1U2(:, 2) - c*(delta_t(2) + delta_t(3))];
Data_U1U3_bias = [Data_U1U3(:, 1), Data_U1U3(:, 2) - c*(delta_t(2) + delta_t(4))];
Data_U2U3_bias = [Data_U2U3(:, 1), Data_U2U3(:, 2) - c*(delta_t(3) + delta_t(4))];

U_distances_bias = (U_distances - (A_binary*delta_t*c)')

% [-0.0507,0.1058]

E_bias = actual_distances - U_distances_bias';

% E_bias = [
%     (Data_U0U1_bias(:,1) - Data_U0U1_bias(:,2))';
%     (Data_U0U2_bias(:,1) - Data_U0U2_bias(:,2))';
%     (Data_U0U3_bias(:,1) - Data_U0U3_bias(:,2))';
%     (Data_U1U2_bias(:,1) - Data_U1U2_bias(:,2))';
%     (Data_U1U3_bias(:,1) - Data_U1U3_bias(:,2))';
%     (Data_U2U3_bias(:,1) - Data_U2U3_bias(:,2))';
% ]

E_bias_total = sum(E_bias, 1) / number_of_experiments;
actual_distances_avg = (U0_actual_distances + U1_actual_distances + U2_actual_distances)/3;

interpolation_p_params = polyfit(actual_distances_avg, E_bias_total, 1);
error_compensation_line = polyval(interpolation_p_params, actual_distances_avg);

plot(U0_actual_distances, Data_U0U1_bias(:,1) - Data_U0U1_bias(:,2), '*')
hold on
plot(U0_actual_distances, Data_U0U2_bias(:,1) - Data_U0U2_bias(:,2), '*')
plot(U0_actual_distances, Data_U0U3_bias(:,1) - Data_U0U3_bias(:,2), '*')
plot(U1_actual_distances, Data_U1U2_bias(:,1) - Data_U1U2_bias(:,2), '*')
plot(U1_actual_distances, Data_U1U3_bias(:,1) - Data_U1U3_bias(:,2), '*')
plot(U2_actual_distances, Data_U2U3_bias(:,1) - Data_U2U3_bias(:,2), '*')
plot(actual_distances_avg, error_compensation_line)

quality = sum(abs(E_bias_total - error_compensation_line));